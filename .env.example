# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in from Project Settings -> API.
#
# Use the ANON key. Never `service_role`: it bypasses row-level security, and
# anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
#
# These are read at BUILD time — rebuild after changing them. Without them the
# app renders a setup screen rather than starting.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Port for `npm run start`. Most Node hosts inject this.
PORT=3000
